# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...your_telegram_token

# Прокси до api.telegram.org. Если пусто — берётся системный прокси Windows.
# Clash/V2Ray обычно: http://127.0.0.1:10809
# Отключить: TELEGRAM_PROXY=direct
# TELEGRAM_PROXY=http://127.0.0.1:10809

# Ключ ChadGPT Public API:
# https://ask.chadgpt.ru/profile/public-api
CHAD_API_KEY=chad-...your_key

# Модель = хвост URL: https://ask.chadgpt.ru/api/public/{модель}
# Примеры: gpt-5-mini, gpt-5-nano, gpt-4o-mini, deepseek-v3.2
CHAD_MODEL=gpt-5-mini

# Обычно менять не нужно
# CHAD_API_BASE=https://ask.chadgpt.ru/api/public

# Токен сообщества VK с правом «Сообщения сообщества»
# Управление → Настройки → Работа с API → Ключи доступа
VK_TOKEN=vk1.a....your_community_token
